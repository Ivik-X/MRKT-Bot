# Интервал между сканами в секундах (по умолчанию 0.5)
SCAN_INTERVAL=0.5

# Минимальная выгода в TON от флора для признания сделки валидной (по умолчанию 2.5)
MIN_TON_DIFF=2.5

# Абсолютный порог: если цена < N TON — сделка без проверки флора (по умолчанию 3.0)
CHEAP_PRICE_THRESHOLD=3.0

# Обновлять флор чёрного фона каждые N сканов (по умолчанию 10)
BLACK_FLOOR_REFRESH=10

# Обновлять кэш флоров моделей каждые N сканов (по умолчанию 10)
MODEL_FLOOR_REFRESH=10

# Минимальный интервал между запросами через один слот (по умолчанию 0.5 сек)
SLOT_COOLDOWN=0.5

# Таймаут одного запроса в секундах (если >1.5с — прокси отключается)
REQUEST_TIMEOUT=1.5

# Кулдаун слота при ответе 429 (по умолчанию 60 сек)
PENALTY_429=60.0
PENALTY_SECONDS=60.0

# Максимум повторных попыток при ошибке (по умолчанию 3)
MAX_RETRIES=3

# Путь к xray бинарнику (если не в PATH)
# XRAY_BIN=/usr/local/bin/xray

# Базовый локальный порт для SOCKS5 прокси (по умолчанию 10800)
# XRAY_BASE_PORT=10800
