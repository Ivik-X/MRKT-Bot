# Интервал между сканами в секундах (по умолчанию 0.5)
SCAN_INTERVAL=0.5

# Минимальная выгода в TON от флора для признания сделки валидной (по умолчанию 2.5)
MIN_TON_DIFF=2.5

# Абсолютный порог: если цена < N TON — сделка без проверки флора (по умолчанию 3.0)
CHEAP_PRICE_THRESHOLD=3.0

# Минимальный коэффициент оборот/цена для NFT (отсекает мёртвый груз, 0 = выкл)
MIN_TURNOVER_RATIO=0.0

# Максимальное соотношение цены к флору для редких ID < 100 (0.20 = 20% флора, 1.20 = флор + 20%)
LOW_ID_MAX_FLOOR_RATIO=0.20

# Фильтровать сделки по доступному балансу (true/false)
FILTER_BY_BALANCE=false

# Основной токен для баланса и покупок (если пусто, берётся 1-й токен из tokens.txt)
PRIMARY_TOKEN=

# Обновлять флор чёрного фона каждые N сканов (по умолчанию 10)
BLACK_FLOOR_REFRESH=10

# Периодичность обновления флоров моделей в часах (по умолчанию 12.0)
MODEL_FLOOR_REFRESH_HOURS=12.0

# Минимальный интервал между запросами через один слот (по умолчанию 0.5 сек)
SLOT_COOLDOWN=0.5

# Таймаут одного запроса в секундах (если >1.5с — прокси отключается)
REQUEST_TIMEOUT=1.5

# Максимальный пинг прокси при первичном тесте при старте в секундах (по умолчанию 3.0)
MAX_PING_SECONDS=3.0

# Кулдаун слота при ответе 429 (по умолчанию 60 сек)
PENALTY_429=60.0
PENALTY_SECONDS=60.0

# Максимум повторных попыток при ошибке (по умолчанию 3)
MAX_RETRIES=3

# Путь к xray бинарнику (если не в PATH)
# XRAY_BIN=/usr/local/bin/xray

# Базовый локальный порт для SOCKS5 прокси (по умолчанию 10800)
# XRAY_BASE_PORT=10800

# Telegram бот для управления и уведомлений (токен от @BotFather)
TG_BOT_TOKEN=

# Telegram ID администратора (узнать у @userinfobot)
TG_ADMIN_ID=

# Моментальные уведомления по категориям (true/false, по умолчанию true)
# Если false — сделки сохраняются в Хранилище бота для выгрузки по кнопке
NOTIFY_BLACK=true
NOTIFY_CHEAP=true
NOTIFY_MODEL=true
NOTIFY_LOW_ID=true

